{
  "name": "remote-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 5174",
    "types": "mkdir -p .wrangler && wrangler types .wrangler/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc -b",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "file-length:check": "eslint . --rule 'max-lines: [error, 300]'",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run file-length:check && npm run test && npm run build && npm run mockups:check",
    "mockups:build": "mokly build --strict",
    "mockups:serve": "mokly serve",
    "mockups:typecheck": "tsc -p docs/mockups/tsconfig.json",
    "mockups:check": "npm run mockups:typecheck && npm run mockups:build",
    "marketing:pictures": "node tools/marketing-pictures/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@firna/ui": "4.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@eslint/js": "^10.0.1",
    "@mokly/mokly": "0.18.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "miniflare": "5.20261101.0-beta",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
