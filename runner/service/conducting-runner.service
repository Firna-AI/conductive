[Unit]
Description=Conducting agent runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=~
ExecStart="@PREFIX@/service/start.sh" "@NODE@"
Restart=always
RestartSec=2
UMask=0077
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
