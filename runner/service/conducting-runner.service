[Unit]
Description=Conducting agent runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=~
Environment="CONDUCTING_NODE=@NODE@"
ExecStart="@PREFIX@/service/start.sh"
Restart=always
RestartSec=2
UMask=0077
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
