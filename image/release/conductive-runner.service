[Unit]
Description=Conductive agent runner
After=network-online.target conductive-update-apply.service
Requires=conductive-update-apply.service
Wants=network-online.target

[Service]
Type=exec
User=user
WorkingDirectory=/home/user
ExecStart=/opt/conductive/current/system/runner-start.sh
ExecStartPost=+/usr/bin/systemctl --no-block start conductive-update-confirm.service conductive-update-check.service
Restart=on-failure
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
