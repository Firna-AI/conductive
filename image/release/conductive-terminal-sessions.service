[Unit]
Description=Conductive terminal shell server
ConditionPathExists=/run/conductive-terminal/enabled

[Service]
Type=forking
User=user
Group=user
WorkingDirectory=/home/user
RuntimeDirectory=conductive-terminal
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/conductive/current/system/terminal-sessions
Restart=on-failure
RestartSec=1
KillMode=control-group
# An out-of-memory kill of one command, such as a large build, ends only
# that command. Every shell and its other commands keep running.
OOMPolicy=continue
