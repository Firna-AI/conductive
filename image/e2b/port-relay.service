[Unit]
Description=Conductive private loopback port relay
After=local-fs.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
RuntimeDirectory=conductive-e2b
RuntimeDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/install -m 0700 /usr/local/lib/conductive-e2b/port-relay.py /run/conductive-e2b/port-relay.py
ExecStart=/usr/bin/python3 /run/conductive-e2b/port-relay.py serve
TimeoutStartSec=8
Restart=on-failure
RestartSec=1
KillMode=control-group

[Install]
WantedBy=multi-user.target
