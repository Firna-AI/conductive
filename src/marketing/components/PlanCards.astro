---
import { planCopy, pricingPageCopy, pricingPlans } from '../pricing'
import Icon from './Icon.astro'

/*
 * The plans side by side, each as a quiet box with its name, its price with
 * what the price covers, and what it includes, then the line on the
 * currency and the tax. No plan is marked above the others, and no box has
 * a button, because nobody chooses a plan before billing starts.
 */
const plans = pricingPlans.map(planCopy)
---

<div class="pricing-plans">
  <ul class="pricing-grid">
    {plans.map((plan) => (
      <li class="pricing-card">
        <h2 class="pricing-name">{plan.name}</h2>
        <p class="pricing-price">
          <span class="pricing-amount">{plan.price}</span>{' '}
          <span class="pricing-unit">{plan.unit}</span>
        </p>
        <ul class="pricing-facts">
          {plan.facts.map((fact) => (
            <li class="pricing-fact">
              <Icon name="circle-check" size={15} class="pricing-fact-icon" />
              {fact}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  <p class="pricing-terms">
    {pricingPageCopy.currency} {pricingPageCopy.tax}
  </p>
</div>
