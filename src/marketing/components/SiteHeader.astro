---
import {
  docsPath,
  sitePaths,
  sourceRepositoryHref,
  type SiteSection,
} from '../links'
import { featuresHref, signInHref } from '../request-values'
import GitHubMark from './GitHubMark.astro'
import StartButton from './StartButton.astro'
import Wordmark from './Wordmark.astro'

/*
 * The top of each page: the lockup, Features, Docs, GitHub, Sign in, and
 * the main action. A phone keeps the lockup, Docs, GitHub as its mark, and
 * Sign in. `current` is the section of the page, such as the docs, which
 * the header marks for sight and for screen readers.
 */
type Props = { current?: SiteSection }

const { current } = Astro.props
const inDocs = current === 'docs'
---

<header class="header">
  <div class="header-inner">
    <Wordmark home={sitePaths.home} />
    <nav aria-label="Site" class="header-nav">
      <a class="header-link header-wide" href={featuresHref}>
        Features
      </a>
      <a
        aria-current={inDocs ? 'true' : undefined}
        class:list={['header-link', { 'header-current': inDocs }]}
        href={docsPath}
      >
        Docs
      </a>
      <a
        class="header-link header-mark"
        href={sourceRepositoryHref}
        title="Open source on GitHub"
      >
        <GitHubMark size={16} />
        <span class="header-mark-label">GitHub</span>
      </a>
      <a class="header-link" href={signInHref}>
        Sign in
      </a>
      <StartButton size="md" class="header-wide" />
    </nav>
  </div>
</header>
