---
import { requestValues, signInHref } from '../request-values'
import GitHubMark from './GitHubMark.astro'

/*
 * The main action of the site, which starts the GitHub sign-in of the app.
 * Its words are a value of the request: during open sign-up they promise
 * use at once, and at all other times a place on the waitlist.
 */
type Props = { size: 'md' | 'lg'; class?: string }

const { size, class: className } = Astro.props
---

<a
  class:list={[
    'button',
    'button-primary',
    { 'button-md': size === 'md' },
    className,
  ]}
  href={signInHref}
>
  <span class="button-icon">
    <GitHubMark size={16} />
  </span>
  <span>{requestValues.startLabel}</span>
</a>
