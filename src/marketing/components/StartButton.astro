---
import { signInHref } from '../request-values'
import GitHubMark from './GitHubMark.astro'

/*
 * The main action of the site, which starts the GitHub sign-in of the app.
 * A new person waits for app access, so the words promise a place on the
 * waitlist, not use at once.
 */
type Props = { size: 'md' | 'lg'; class?: string }

const { size, class: className } = Astro.props
---

<a
  class:list={[
    'button',
    'button-primary',
    { 'button-md': size === 'md' },
    className,
  ]}
  href={signInHref}
>
  <span class="button-icon">
    <GitHubMark size={16} />
  </span>
  <span>Join the waitlist</span>
</a>
