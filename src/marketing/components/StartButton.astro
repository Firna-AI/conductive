---
import { siteActionCopy } from '../access-copy'
import { signInHref } from '../request-values'
import GitHubMark from './GitHubMark.astro'

/*
 * The main action of the site, Sign up, which starts the GitHub sign-in of
 * the app. The first sign-in of a new person creates the account, which then
 * waits for app access.
 */
type Props = { size: 'md' | 'lg'; class?: string }

const { size, class: className } = Astro.props
---

<a
  class:list={[
    'button',
    'button-primary',
    { 'button-md': size === 'md' },
    className,
  ]}
  href={signInHref}
>
  <span class="button-icon">
    <GitHubMark size={16} />
  </span>
  <span>{siteActionCopy.signUp}</span>
</a>
