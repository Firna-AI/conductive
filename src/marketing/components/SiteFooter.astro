---
import { productName } from '../../../docs/mockups/src/brand'
import { siteActionCopy } from '../access-copy'
import { productSummary } from '../features'
import { parityLinkCopy } from '../from-conductor/copy'
import { abuseAddress } from '../legal-text'
import { docsPath, sitePaths } from '../links'
import {
  featuresHref,
  macAppHref,
  requestValues,
  signInHref,
} from '../request-values'
import FooterColumn from './FooterColumn.astro'
import Wordmark from './Wordmark.astro'

/*
 * The foot of each page: the lockup, the sections with the docs and the
 * page for people who move from Conductor Cloud, the sign-in, the address
 * for abuse reports, and the legal pages beside the copyright.
 */
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Wordmark home={sitePaths.home} />
      <p class="footer-tagline">{productSummary.tagline}</p>
    </div>
    <FooterColumn title="Product">
      <li>
        <a class="footer-link" href={featuresHref}>
          Features
        </a>
      </li>
      <li>
        <a class="footer-link" href={docsPath}>
          Docs
        </a>
      </li>
      <li>
        <a class="footer-link" href={macAppHref}>
          Mac app
        </a>
      </li>
      <li>
        <a class="footer-link" href={sitePaths.fromConductor}>
          {parityLinkCopy.footer}
        </a>
      </li>
    </FooterColumn>
    <FooterColumn title="Account">
      <li>
        <a class="footer-link" href={signInHref}>
          {siteActionCopy.signUp}
        </a>
      </li>
      <li>
        <a class="footer-link" href={signInHref}>
          Sign in
        </a>
      </li>
    </FooterColumn>
    <FooterColumn title="Report abuse">
      <li>
        <a class="footer-link" href={`mailto:${abuseAddress}`}>
          {abuseAddress}
        </a>
      </li>
    </FooterColumn>
  </div>
  <div class="footer-inner footer-bottom">
    <p class="footer-legal">
      © {requestValues.year} {productName}
    </p>
    <nav aria-label="Legal" class="legal-links">
      <a class="legal-link" href={sitePaths.terms}>
        Terms
      </a>
      <a class="legal-link" href={sitePaths.privacy}>
        Privacy
      </a>
    </nav>
  </div>
</footer>
