---
import { productName } from '../../../docs/mockups/src/brand'
import { abuseAddress } from '../legal-text'
import { sitePaths } from '../links'
import { featuresHref, requestValues, signInHref } from '../request-values'
import FooterColumn from './FooterColumn.astro'
import Wordmark from './Wordmark.astro'

/*
 * The foot of each page: the lockup, the sections, the main action and the
 * sign-in, the address for abuse reports, and the legal pages beside the
 * copyright. The main action has the words of the request, as each main
 * action of the site does.
 */
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Wordmark home={sitePaths.home} />
      <p class="footer-tagline">
        Coding agents on cloud computers, in your browser.
      </p>
    </div>
    <FooterColumn title="Product">
      <li>
        <a class="footer-link" href={featuresHref}>
          Features
        </a>
      </li>
    </FooterColumn>
    <FooterColumn title="Account">
      <li>
        <a class="footer-link" href={signInHref}>
          {requestValues.startLabel}
        </a>
      </li>
      <li>
        <a class="footer-link" href={signInHref}>
          Sign in
        </a>
      </li>
    </FooterColumn>
    <FooterColumn title="Report abuse">
      <li>
        <a class="footer-link" href={`mailto:${abuseAddress}`}>
          {abuseAddress}
        </a>
      </li>
    </FooterColumn>
  </div>
  <div class="footer-inner footer-bottom">
    <p class="footer-legal">
      © {requestValues.year} {productName}
    </p>
    <nav aria-label="Legal" class="legal-links">
      <a class="legal-link" href={sitePaths.terms}>
        Terms
      </a>
      <a class="legal-link" href={sitePaths.privacy}>
        Privacy
      </a>
    </nav>
  </div>
</footer>
