---
import { pricingPageCopy } from '../pricing'
import SectionIntro from './SectionIntro.astro'

/*
 * How cloud hours count: the size of each cloud computer, then each rule
 * under a neutral hairline. A desktop shows the rules in two columns, and a
 * phone stacks them.
 */
const copy = pricingPageCopy.hours
---

<section class="pricing-hours">
  <SectionIntro label={copy.label} title={copy.title} text={copy.text} />
  <ul class="pricing-rules">
    {copy.rules.map((rule) => (
      <li class="pricing-rule">
        <h3 class="pricing-rule-title">{rule.title}</h3>
        <p class="pricing-rule-text">{rule.text}</p>
      </li>
    ))}
  </ul>
</section>
