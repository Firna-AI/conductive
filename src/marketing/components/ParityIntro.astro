---
import { parityPageCopy } from '../from-conductor/copy'
import CopyText from './CopyText.astro'
import Icon from './Icon.astro'

/*
 * The top of the comparison page: the title, one sentence, the note that
 * the list covers Conductor Cloud only, the days of Conductor Cloud beside
 * its announcement, and the day of the last check of the list.
 */
const copy = parityPageCopy
---

<header class="parity-intro">
  <span class="parity-label">{copy.label}</span>
  <h1 class="parity-title">{copy.title}</h1>
  <p class="parity-lead">{copy.lead}</p>
  <div class="parity-scope" role="note">
    <Icon name="cloud" size={16} class="parity-scope-icon" />
    <p class="parity-scope-text">
      <strong class="parity-scope-title">{copy.scope.title}</strong>{' '}
      {copy.scope.text}
    </p>
  </div>
  <p class="parity-facts">
    <CopyText text={copy.cloudDays} /> <CopyText text={copy.checked} />
  </p>
</header>
