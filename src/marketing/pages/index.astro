---
import { productName } from '../../../docs/mockups/src/brand'
import { waitlistText } from '../access-copy'
import ClosingCall from '../components/ClosingCall.astro'
import FeatureSection from '../components/FeatureSection.astro'
import Icon from '../components/Icon.astro'
import MacDownloads from '../components/MacDownloads.astro'
import PictureFrame from '../components/PictureFrame.astro'
import SectionIntro from '../components/SectionIntro.astro'
import SiteActions from '../components/SiteActions.astro'
import {
  features,
  macAppSection,
  productSummary,
  smallerFeatures,
} from '../features'
import { parityLinkCopy } from '../from-conductor/copy'
import SiteLayout from '../layouts/SiteLayout.astro'
import { sitePaths } from '../links'

/*
 * The home page: the hero with a short link to the page for people who
 * move from Conductor Cloud and the app, the features with real screens,
 * the Mac app with its downloads, the smaller features, and a last call to
 * action.
 */
---

<SiteLayout
  title={`${productName} – Coding agents on cloud computers, in your browser`}
  description={productSummary.heroText}
>
  <main class="main">
    <section class="hero">
      <div class="hero-copy">
        <a class="hero-notice" href={sitePaths.fromConductor}>
          {parityLinkCopy.home}
          <Icon name="arrow-right" size={14} class="hero-notice-icon" />
        </a>
        <h1 class="hero-title">
          Give every coding task its own cloud computer.
        </h1>
        <p class="hero-text">{productSummary.heroText}</p>
        <SiteActions />
      </div>
      <div class="hero-picture">
        <PictureFrame picture="hero" loading="eager" />
      </div>
    </section>
    <div class="sections" id="features">
      {features.map((feature) => (
        <FeatureSection feature={feature} />
      ))}
      <FeatureSection feature={macAppSection} id="mac-app">
        <MacDownloads
          downloads={macAppSection.downloads}
          requirement={macAppSection.requirement}
        />
      </FeatureSection>
      <section class="grid-section">
        <SectionIntro
          label="And more"
          title="Less to look after."
          text="The app starts and stops the cloud computers for you."
        />
        <ul class="grid">
          {smallerFeatures.map((item) => (
            <li class="grid-item">
              <Icon name={item.icon} size={16} class="grid-icon" />
              <h3 class="grid-title">{item.title}</h3>
              <p class="grid-text">{item.text}</p>
            </li>
          ))}
        </ul>
      </section>
      <ClosingCall
        title="Give your next task its own cloud computer."
        text={waitlistText}
      />
    </div>
  </main>
</SiteLayout>
