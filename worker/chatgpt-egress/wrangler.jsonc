{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conductive-chatgpt-egress",
  "main": "./index.ts",
  "compatibility_date": "2026-11-06",
  // Only the main Worker reaches this Worker, through its service binding.
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "VERSION" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "containers": [
    {
      "class_name": "ChatGptEgress",
      // Each Durable Object starts the image of its own Worker version, with
      // the lite size. A deploy then replaces no running container.
      "scheduling_policy": "durable_object",
      "images": {
        "proxy": { "dockerfile": "../../tools/chatgpt-egress/Dockerfile" },
      },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "EGRESS", "class_name": "ChatGptEgress" }],
    // The object of an old version keeps its code for up to 15 minutes, so
    // that its open answers can finish.
    "code_update_strategy": { "mode": "deferred", "max_delay": 900 },
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatGptEgress"] }],
}
