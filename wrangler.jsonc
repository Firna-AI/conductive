{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conductive",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "triggers": { "crons": ["*/15 * * * *"] },
  // The deployment serves only its own hostnames.
  "workers_dev": false,
  "preview_urls": false,
  // Keep deployment-specific public variables that this file does not set.
  "keep_vars": true,
  "ai": { "binding": "AI" },
  // Workers Logs keeps each log line, also of the workspace objects.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // A query string can hold a sign-in code or a preview credential.
    "redact_query_string": true,
  },
  "routes": [
    { "pattern": "conductive.build", "custom_domain": true },
    { "pattern": "app.conductive.build", "custom_domain": true },
    { "pattern": "api.conductive.build", "custom_domain": true },
    { "pattern": "*.conductive.page/*", "zone_name": "conductive.page" },
  ],
  "vars": {
    "MACHINE_ORIGIN": "https://api.conductive.build",
    "PREVIEW_DOMAIN": "conductive.page",
    "CONDUCTIVE_TITLE_MODEL": "@cf/ibm-granite/granite-4.0-h-micro",
    // The model readers expect JSON encoded as text, not JSON bindings.
    "CONDUCTIVE_MODELS": "[{\"agent\":\"claude\",\"model\":\"claude-opus-5-5\",\"label\":\"Opus 5.5\",\"efforts\":[\"low\",\"medium\",\"high\",\"max\"]},{\"agent\":\"claude\",\"model\":\"claude-sonnet-5-5\",\"label\":\"Sonnet 5.5\",\"efforts\":[\"low\",\"medium\",\"high\",\"max\"]},{\"agent\":\"claude\",\"model\":\"claude-haiku-5-5\",\"label\":\"Haiku 5.5\",\"efforts\":[\"low\",\"medium\",\"high\",\"max\"]},{\"agent\":\"claude\",\"model\":\"claude-fable-5-2\",\"label\":\"Fable 5.2\",\"efforts\":[\"low\",\"medium\",\"high\",\"xhigh\",\"max\"]},{\"agent\":\"codex\",\"model\":\"gpt-6.1-sol\",\"label\":\"GPT-6.1 Sol\",\"efforts\":[\"low\",\"medium\",\"high\",\"xhigh\"]},{\"agent\":\"codex\",\"model\":\"gpt-6-astra\",\"label\":\"GPT-6 Astra\",\"efforts\":[\"low\",\"medium\",\"high\",\"xhigh\"]},{\"agent\":\"codex\",\"model\":\"gpt-6.1-terra\",\"label\":\"GPT-6.1 Terra\",\"efforts\":[\"low\",\"medium\",\"high\",\"xhigh\"]},{\"agent\":\"codex\",\"model\":\"gpt-6-luna\",\"label\":\"GPT-6 Luna\",\"efforts\":[\"low\",\"medium\",\"high\",\"xhigh\"]}]",
    "CONDUCTIVE_DEFAULT_CHOICE": "{\"agent\":\"claude\",\"model\":\"claude-opus-5-5\",\"effort\":\"high\"}",
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "Workspace" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conductive",
      // The production database, created in Western Europe.
      "database_id": "50e387ff-2b37-4221-a0dc-fe999703e559",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CHAT_ATTACHMENTS",
      "bucket_name": "conductive-chat-attachments",
    },
  ],
}
