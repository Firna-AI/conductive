{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conducting",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "Workspace" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conductive",
      // The production database, created in Western Europe.
      "database_id": "50e387ff-2b37-4221-a0dc-fe999703e559",
      "migrations_dir": "migrations",
    },
  ],
}
